# PostgreSQL Connection URL (PostgreSQL + Prisma)
# Replace credentials with your PostgreSQL instance settings
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/roxiler_store_rating_db?schema=public"

# JWT Secret Key for token signing and verification
JWT_SECRET="your_super_secret_jwt_key_roxiler_assessment_change_in_production"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"
